{
  "name": "Redcloud ERP - Auth & User Management PostgreSQL Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "erp-auth",
        "options": {
          "responseMode": "responseNode"
        }
      },
      "name": "Auth Webhook (/webhook/erp-auth)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "value1": "={{ $json.body.operation || $json.operation }}",
              "value2": "login",
              "operation": "equal"
            },
            {
              "value1": "={{ $json.body.operation || $json.operation }}",
              "value2": "create_user",
              "operation": "equal"
            },
            {
              "value1": "={{ $json.body.operation || $json.operation }}",
              "value2": "list_users",
              "operation": "equal"
            },
            {
              "value1": "={{ $json.body.operation || $json.operation }}",
              "value2": "list_audit_logs",
              "operation": "equal"
            }
          ]
        }
      },
      "name": "Route Operation",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, email, role, needs_password_change, password_hash FROM erp_users WHERE LOWER(email) = LOWER('{{ $json.body.email }}');"
      },
      "name": "Postgres Login Query",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        720,
        150
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-credentials-id",
          "name": "ERP PostgreSQL Database"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const inputPassword = $node['Auth Webhook (/webhook/erp-auth)'].json.body.password;\nconst dbUser = items[0]?.json;\n\nif (!dbUser) {\n  return [{ json: { success: false, message: 'User not found. Ask Superadmin to create your account.' } }];\n}\n\nif (dbUser.password_hash !== inputPassword) {\n  return [{ json: { success: false, message: 'Invalid credentials' } }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    user: {\n      id: dbUser.id,\n      email: dbUser.email,\n      role: dbUser.role,\n      needs_password_change: dbUser.needs_password_change\n    }\n  }\n}];"
      },
      "name": "Verify Credentials & Hash",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        940,
        150
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO erp_users (email, role, password_hash, needs_password_change, created_at)\nVALUES (\n  LOWER('{{ $json.body.email }}'),\n  '{{ $json.body.role || \"admin\" }}',\n  '{{ $json.body.password }}',\n  TRUE,\n  NOW()\n)\nON CONFLICT (email) DO UPDATE SET\n  role = EXCLUDED.role,\n  password_hash = EXCLUDED.password_hash,\n  needs_password_change = TRUE;\n\nINSERT INTO audit_logs (user_email, action, target_user, ip_address, timestamp)\nVALUES (\n  'superadmin@company.com',\n  'Create Operator User',\n  '{{ $json.body.email }}',\n  '127.0.0.1',\n  NOW()\n);\n\nSELECT 'User created successfully' AS message;"
      },
      "name": "Postgres Create User",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        720,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-credentials-id",
          "name": "ERP PostgreSQL Database"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "return [{ json: { success: true, message: 'User created/updated in PostgreSQL database.' } }];"
      },
      "name": "Format Create Success",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, email, role, needs_password_change, created_at FROM erp_users ORDER BY created_at DESC;"
      },
      "name": "Postgres List Users",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        720,
        450
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-credentials-id",
          "name": "ERP PostgreSQL Database"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, user_email, action, target_user, ip_address, timestamp FROM audit_logs ORDER BY timestamp DESC LIMIT 50;"
      },
      "name": "Postgres List Audit Logs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        720,
        600
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-credentials-id",
          "name": "ERP PostgreSQL Database"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Respond to Frontend",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1180,
        300
      ]
    }
  ],
