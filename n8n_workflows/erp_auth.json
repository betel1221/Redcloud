              "value2": "list_users"
            },
            {
              "value1": "={{ $json.body.operation }}",
              "value2": "backup_db"
            }
          ]
        }
      },
      "id": "switch-auth-id",
      "name": "Route Auth Operations",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        450,
        400
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, email, role, password_hash, avatar, needs_password_change FROM erp_users WHERE LOWER(email) = LOWER('{{ $json.body.email }}');"
      },
      "id": "db-login-query-id",
      "name": "Postgres Login Query",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        700,
        150
      ],
      "credentials": {
        "postgres": {
          "name": "Red_db"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const dbUser = $input.first().json;\nconst inputPassword = $('Auth Webhook').first().json.body.password;\n\nif (!dbUser || !dbUser.email) {\n  return [{ json: { success: false, message: 'User account not found.' } }];\n}\n\nif (dbUser.password_hash !== inputPassword) {\n  return [{ json: { success: false, message: 'Invalid email or password.' } }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    user: {\n      id: dbUser.id,\n      email: dbUser.email,\n      role: dbUser.role,\n      avatar: dbUser.avatar,\n      needs_password_change: !!dbUser.needs_password_change\n    }\n  }\n}];"
      },
      "id": "verify-creds-id",
      "name": "Verify Credentials",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        150
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO erp_users (email, role, password_hash, needs_password_change, created_at)\nVALUES (LOWER('{{ $json.body.email }}'), '{{ $json.body.role || \"admin\" }}', '{{ $json.body.password }}', TRUE, NOW())\nON CONFLICT (email) DO UPDATE SET role = EXCLUDED.role, password_hash = EXCLUDED.password_hash, needs_password_change = TRUE;\nSELECT 'User created/updated' AS status;"
      },
      "id": "db-create-user-id",
      "name": "Postgres Create User",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        700,
        280
      ],
      "credentials": {
        "postgres": {
          "name": "Red_db"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { success: true, message: 'User account saved in database.' } }];"
      },
      "id": "success-create-id",
      "name": "Format Create Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        280
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE erp_users SET avatar = '{{ $json.body.avatar }}' WHERE LOWER(email) = LOWER('{{ $json.body.email }}');\nSELECT 'Avatar updated' as status;"
      },
      "id": "db-update-avatar-id",
      "name": "Postgres Update Avatar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        700,
        410
      ],
      "credentials": {
        "postgres": {
          "name": "Red_db"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE erp_users SET password_hash = '{{ $json.body.password }}', needs_password_change = FALSE WHERE LOWER(email) = LOWER('{{ $json.body.email }}');\nSELECT 'Password updated' as status;"
      },
      "id": "db-update-pass-id",
      "name": "Postgres Update Password",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        700,
        540
      ],
      "credentials": {
        "postgres": {
          "name": "Red_db"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, email, role, needs_password_change, created_at, avatar FROM erp_users ORDER BY created_at DESC;"
      },
      "id": "db-list-users-id",
      "name": "Postgres List Users",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        700,
