                "value": "OPTIONS,GET,PUT,POST,DELETE"
              }
            ]
          }
        },
        "responseMode": "responseNode"
      },
      "id": "webhook-auth-id",
      "name": "Auth Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "value1": "={{ $json.body.operation }}",
              "value2": "login"
            },
            {
              "value1": "={{ $json.body.operation }}",
              "value2": "create_user"
            },
            {
              "value1": "={{ $json.body.operation }}",
              "value2": "update_avatar"
            },
            {
              "value1": "={{ $json.body.operation }}",
