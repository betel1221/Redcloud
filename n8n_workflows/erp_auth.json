          "name": "Red_db"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO emergency_backups (database_name, backup_file_name, file_size_bytes, status, backup_data, created_at)\nVALUES ('{{ $json.body.database_name }}', '{{ $json.body.file_name }}', {{ $json.body.file_size || 0 }}, 'COMPLETED', '{{ $json.body.backup_data || \"\" }}', NOW());\nSELECT 'Backup stored successfully' as status;"
      },
      "id": "db-backup-db-id",
      "name": "Postgres Emergency Backup",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        700,
        800
      ],
      "credentials": {
        "postgres": {
          "name": "Red_db"
        }
      }
