        1088,
        864
      ],
      "id": "80872eda-594c-4ed9-9f26-d9026a3ba06f"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT server_name, status, cpu_usage, memory_usage, disk_usage, network_speed, temperature_c, running_services, uptime \nFROM server_metrics \nORDER BY id DESC;",
        "additionalFields": {}
      },
      "name": "Postgres Get Telemetry (erp_demo)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1088,
        1008
      ],
      "id": "5302b9f8-b13b-4a3a-acd6-6ea646dde5b2"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.datname AS name,\n  'PostgreSQL 15' AS type,\n  CASE WHEN d.datistemplate THEN 'Template' ELSE 'Online & Active' END AS status,\n  pg_size_pretty(pg_database_size(d.datname)) AS storage,\n  (SELECT COUNT(*) FROM information_schema.tables WHERE table_catalog = d.datname AND table_schema NOT IN ('pg_catalog','information_schema'))::int AS tables,\n  (SELECT count(*) FROM pg_stat_activity WHERE datname = d.datname)::text || ' / ' || current_setting('max_connections') AS connections,\n  CASE WHEN (SELECT count(*) FROM pg_stat_replication) > 0 THEN 'Streaming' ELSE 'Standalone' END AS replication,\n  COALESCE((SELECT pg_size_pretty(pg_database_size(d.datname))), '\u2014') AS backup\nFROM pg_database d\nWHERE d.datname IN ('erp_demo', 'server_metrics', 'FOODAPPANDDB')\nORDER BY d.datname;",
        "additionalFields": {}
      },
