    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.id, s.domain, s.title, s.is_pinned, s.updated_at,\n       COALESCE(json_agg(json_build_object('id', m.id, 'session_id', m.session_id, 'sender', m.sender, 'text', m.text, 'timestamp', m.timestamp) ORDER BY m.id ASC) FILTER (WHERE m.id IS NOT NULL), '[]'::json) AS messages\nFROM chat_sessions s\nLEFT JOIN chat_messages m ON s.id = m.session_id\nWHERE s.domain = '{{ $json.body.domain || $json.query.domain || \"database\" }}'\nGROUP BY s.id, s.domain, s.title, s.is_pinned, s.updated_at\nORDER BY s.updated_at DESC;",
        "additionalFields": {}
      },
      "name": "Postgres Load Chat History (erp_demo)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1088,
        576
      ],
      "id": "23e46ab6-3cf8-4f31-ab25-2971183531c4"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO chat_sessions (id, domain, title, is_pinned, updated_at)\nVALUES (\n  '{{ $json.body.session_id || $json.body.id }}',\n  '{{ $json.body.domain || \"database\" }}',\n  '{{ ($json.body.title || \"New Chat\").replace(/'/g, \"''\") }}',\n  {{ $json.body.is_pinned ? true : false }},\n  NOW()\n)\nON CONFLICT (id) DO UPDATE SET\n  title = EXCLUDED.title,\n  is_pinned = EXCLUDED.is_pinned,\n  updated_at = NOW()\nRETURNING id, 'Session saved successfully' AS status;",
        "additionalFields": {}
      },
      "name": "Postgres Save Session (erp_demo)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1088,
        720
      ],
      "id": "9629774b-f0e1-480c-9ef1-407c300970d2"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO chat_messages (id, session_id, sender, text, message, timestamp)\nVALUES (\n  {{ $json.body.message.id }},\n  '{{ $json.body.session_id }}',\n  '{{ $json.body.message.sender }}',\n  '{{ ($json.body.message.text || \"\").replace(/'/g, \"''\") }}',\n  '{{ ($json.body.message.text || \"\").replace(/'/g, \"''\") }}',\n  '{{ $json.body.message.timestamp }}'\n)\nON CONFLICT (id) DO UPDATE SET \n  text = EXCLUDED.text,\n  message = EXCLUDED.message\nRETURNING id, 'Message saved' AS status;\n",
        "additionalFields": {}
      },
      "name": "Postgres Save Message (erp_demo)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
