        ],
        "id": "7ef461ee-c54a-4237-91f8-f68f72a6b93b"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO erp_users (email, role, password_hash, needs_password_change, created_at)\nVALUES (\n  LOWER('{{ $json.body.email }}'),\n  '{{ $json.body.role || \"admin\" }}',\n  '{{ $json.body.password }}',\n  TRUE,\n  NOW()\n)\nON CONFLICT (email) DO UPDATE SET\n  role = EXCLUDED.role,\n  password_hash = EXCLUDED.password_hash,\n  needs_password_change = TRUE;\n\nINSERT INTO audit_logs (user_email, action, target_user, ip_address, timestamp)\nVALUES (\n  'superadmin@company.com',\n  'Create Operator User',\n  '{{ $json.body.email }}',\n  '127.0.0.1',\n  NOW()\n);\n\nSELECT 'User created successfully' AS message;",
          "additionalFields": {}
        },
