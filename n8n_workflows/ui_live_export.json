      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT d.datname AS name,\n  'PostgreSQL 15' AS type,\n  CASE WHEN d.datistemplate THEN 'Template' ELSE 'Online & Active' END AS status,\n  pg_size_pretty(pg_database_size(d.datname)) AS storage,\n  (SELECT COUNT(*) FROM information_schema.tables WHERE table_catalog = d.datname AND table_schema NOT IN ('pg_catalog','information_schema'))::int AS tables,\n  (SELECT count(*) FROM pg_stat_activity WHERE datname = d.datname)::text || ' / ' || current_setting('max_connections') AS connections,\n  CASE WHEN (SELECT count(*) FROM pg_stat_replication) > 0 THEN 'Streaming' ELSE 'Standalone' END AS replication,\n  COALESCE((SELECT pg_size_pretty(pg_database_size(d.datname))), '\u0003') AS backup\nFROM pg_database d\nWHERE d.datname IN ('erp_demo', 'server_metrics', 'FOODAPPANDDB')\nORDER BY d.datname;",
          "additionalFields": {}
