      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT s.id, s.domain, s.title, s.is_pinned, s.updated_at,\n       COALESCE(json_agg(json_build_object('id', m.id, 'session_id', m.session_id, 'sender', m.sender, 'text', COALESCE(m.text, m.message), 'timestamp', m.timestamp) ORDER BY m.id ASC) FILTER (WHERE m.id IS NOT NULL), '[]'::json) AS messages\nFROM chat_sessions s\nLEFT JOIN chat_messages m ON s.id = m.session_id\nWHERE s.domain = '{{ $json.body.domain || $json.query.domain || \"database\" }}'\nGROUP BY s.id, s.domain, s.title, s.is_pinned, s.updated_at\nORDER BY s.updated_at DESC;",
          "additionalFields": {}
        },
        "name": "Postgres Load Chat History (erp_demo)",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 1,
        "position": [
          784,
