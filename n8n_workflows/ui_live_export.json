      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO chat_sessions (id, domain, title, is_pinned, updated_at)\nVALUES (\n  '{{ $json.body.session_id || $json.body.id }}',\n  '{{ $json.body.domain || \"database\" }}',\n  '{{ ($json.body.title || \"New Chat\").replace(/'/g, \"''\") }}',\n  {{ $json.body.is_pinned ? true : false }},\n  NOW()\n)\nON CONFLICT (id) DO UPDATE SET\n  title = EXCLUDED.title,\n  is_pinned = EXCLUDED.is_pinned,\n  updated_at = NOW()\nRETURNING id, 'Session saved successfully' AS status;\n",
          "additionalFields": {}
        },
        "name": "Postgres Save Session (erp_demo)",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 1,
        "position": [
          784,
